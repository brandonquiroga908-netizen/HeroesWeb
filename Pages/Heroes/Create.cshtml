@page
@model HeroesWeb.Pages_Heroes.CreateModel

@{
    ViewData["Title"] = "Registrar héroe";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h2 class="mb-0">Registrar nuevo héroe</h2>
                    <small>Complete la información del héroe</small>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Heroes.Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Heroes.Nombre"
                                   class="form-control"
                                   placeholder="Ej. Superman" />

                            <span asp-validation-for="Heroes.Nombre"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Heroes.Ciudad"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Heroes.Ciudad"
                                   class="form-control"
                                   placeholder="Ej. Metrópolis" />

                            <span asp-validation-for="Heroes.Ciudad"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Heroes.IdentidadSecreta"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Heroes.IdentidadSecreta"
                                   class="form-control"
                                   placeholder="Ingrese la identidad secreta" />

                            <span asp-validation-for="Heroes.IdentidadSecreta"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Registrar héroe
                            </button>

                            <a asp-page="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}