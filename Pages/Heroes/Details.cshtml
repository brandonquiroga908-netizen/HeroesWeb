@page
@model HeroesWeb.Pages_Heroes.DetailsModel

@{
    ViewData["Title"] = "Detalles del héroe";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white py-3">
                    <h2 class="mb-0">Detalles del héroe</h2>
                    <small>Información registrada del héroe</small>
                </div>

                <div class="card-body p-4">

                    <dl class="row mb-4">

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Heroes.Nombre)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Heroes.Nombre)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Heroes.Ciudad)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Heroes.Ciudad)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Heroes.IdentidadSecreta)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Heroes.IdentidadSecreta)
                        </dd>

                    </dl>

                    <div class="d-flex gap-2">
                        <a asp-page="./Edit"
                           asp-route-id="@Model.Heroes.Id"
                           class="btn btn-primary">
                            Editar héroe
                        </a>

                        <a asp-page="./Index"
                           class="btn btn-outline-secondary">
                            Volver a la lista
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>