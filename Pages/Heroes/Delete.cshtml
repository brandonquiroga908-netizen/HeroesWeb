@page
@model HeroesWeb.Pages_Heroes.DeleteModel

@{
    ViewData["Title"] = "Eliminar héroe";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-danger text-white py-3">
                    <h2 class="mb-0">Eliminar héroe</h2>
                    <small>Confirme la eliminación del héroe</small>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning" role="alert">
                        <strong>Advertencia:</strong>
                        Esta acción no se puede deshacer.
                    </div>

                    <div class="mb-4">
                        <h5 class="mb-3">Información del héroe</h5>

                        <dl class="row mb-0">

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Heroes.Nombre)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Heroes.Nombre)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Heroes.Ciudad)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Heroes.Ciudad)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Heroes.IdentidadSecreta)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Heroes.IdentidadSecreta)
                            </dd>

                        </dl>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        Al eliminar este héroe también se eliminarán todos sus superpoderes.
                    </div>

                    <form method="post">

                        <input type="hidden" asp-for="Heroes.Id" />

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-danger">
                                Eliminar héroe
                            </button>

                            <a asp-page="./Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>