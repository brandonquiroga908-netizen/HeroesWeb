@page
@model HeroesWeb.Pages_SuperPoderes.DeleteModel

@{
    ViewData["Title"] = "Eliminar superpoder";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-danger text-white py-3">
                    <h2 class="mb-0">Eliminar superpoder</h2>
                    <small>Confirme la eliminación del superpoder</small>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning" role="alert">
                        <strong>Advertencia:</strong>
                        Esta acción no se puede deshacer.
                    </div>

                    <div class="mb-4">
                        <h5 class="mb-3">Información del superpoder</h5>

                        <dl class="row mb-0">

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.SuperPoderes.Nombre)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.SuperPoderes.Nombre)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.SuperPoderes.Descripcion)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.SuperPoderes.Descripcion)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.SuperPoderes.Heroe)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.SuperPoderes.Heroe.Nombre)
                            </dd>

                        </dl>
                    </div>

                    <form method="post">

                        <input type="hidden" asp-for="SuperPoderes.Id" />

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-danger">
                                Eliminar superpoder
                            </button>

                            <a asp-page="./Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>